# Line ends are part of what these files are, so git must not change them on any system.
# Shell scripts and the macOS launchers need LF; a Windows batch file needs CRLF and is stored with them.
*.sh        text eol=lf
*.command   text eol=lf
*.bat       -text
# Everything else that is text is stored with LF, whatever system it was edited on.
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.lock      text eol=lf
*.png       binary
