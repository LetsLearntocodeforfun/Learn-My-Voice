{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learn My Voice",
  "mainBinaryName": "learn-my-voice",
  "version": "0.2.0",
  "identifier": "io.github.letslearntocodeforfun.learn-my-voice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A script studio for short videos that runs on this computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "core/"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
