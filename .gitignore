# Local data: scripts database, API keys, voice profile. Never commit.
data/
# On-device Whisper: its own Python environment, packages and model. Never commit.
local_tools/
__pycache__/
*.pyc
.DS_Store
# Written into a release package when it is built (tools/build_release.py). Never part of the source.
studio/build.json
# Where release packages are built locally.
dist/
# The desktop app: what its build puts in place and what it makes (desktop/build.py).
desktop/src-tauri/core/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/release.conf.json
